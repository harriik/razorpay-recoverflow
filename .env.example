# Copy to .env and adjust — never commit .env with real secrets
# Backend / Database
POSTGRES_DB=recoverflow
POSTGRES_USER=recoverflow
POSTGRES_PASSWORD=recoverflow
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/recoverflow
DATABASE_USER=recoverflow
DATABASE_PASSWORD=recoverflow

# Backend ports / demo auth
BACKEND_PORT=8080
FRONTEND_PORT=3000
DEMO_API_KEY=demo-key-change-me
DEMO_MERCHANT_ID=00000000-0000-0000-0000-000000000001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# AI (Phase 3+ — leave empty for Phase 1)
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=

# Razorpay (Phase 3+ test mode only — never commit real keys)
RAZORPAY_MODE=simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
